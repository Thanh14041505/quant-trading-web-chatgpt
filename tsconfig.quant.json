{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    "src/models/market.ts",
    "src/indicators/**/*.ts",
    "src/quant/features/**/*.ts",
    "src/quant/regime/**/*.ts",
    "src/quant/tplus/**/*.ts",
    "src/quant/hold/**/*.ts",
    "src/quant/backtest/**/*.ts",
    "src/quant/index.ts"
  ]
}
