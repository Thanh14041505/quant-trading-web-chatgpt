# Optional: normally safer/easier to run setup_vnstock_key.py once.
# If set, the adapter applies this key at startup. Never commit a real .env file.
VNSTOCK_API_KEY=

# Allow only your local Vite development app by default.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 1.1 seconds keeps requests conservative for the free VNStock Community tier.
VNSTOCK_MIN_CALL_INTERVAL_SECONDS=1.1
DEFAULT_HISTORY_COUNT=250
CACHE_MAX_ITEMS=256
